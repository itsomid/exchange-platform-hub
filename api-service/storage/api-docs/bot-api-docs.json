        "/generate-orders/{currency_id}": {
            "post": {
                "tags": [
                    "Spot Bot Operations"
                ],
                "summary": "Generate orders for specific currency",
                "description": "Generate new bot orders for a specific currency. You can optionally specify the number of buy and sell orders to generate. If not provided, the values from bot settings will be used.",
                "operationId": "generateOrdersForCurrency",
                "parameters": [
                    {
                        "name": "currency_id",
                        "in": "path",
                        "description": "Currency ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Optional parameters to override bot settings",
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "buy_orders_count": {
                                        "description": "Number of buy orders to generate (optional, defaults to bot setting)",
                                        "type": "integer",
                                        "minimum": 0,
                                        "example": 5
                                    },
                                    "sell_orders_count": {
                                        "description": "Number of sell orders to generate (optional, defaults to bot setting)",
                                        "type": "integer",
                                        "minimum": 0,
                                        "example": 5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Orders generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Orders generated successfully for Bitcoin"
                                        },
                                        "data": {
                                            "properties": {
                                                "currency": {
                                                    "type": "string",
                                                    "example": "BTC"
                                                },
                                                "market_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "current_price": {
                                                    "type": "string",
                                                    "example": "45000.00000000"
                                                },
                                                "total_orders_generated": {
                                                    "type": "integer",
                                                    "example": 10
                                                },
                                                "buy_orders_count": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "sell_orders_count": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "order_margin": {
                                                    "type": "string",
                                                    "example": "0.5"
                                                },
                                                "orders": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "side": {
                                                                "type": "string",
                                                                "enum": [
                                                                    "buy",
                                                                    "sell"
                                                                ],
                                                                "example": "buy"
                                                            },
                                                            "price": {
                                                                "type": "string",
                                                                "example": "44775.00000000"
                                                            },
                                                            "quantity": {
                                                                "type": "string",
                                                                "example": "0.05000000"
                                                            },
                                                            "order_id": {
                                                                "type": "integer",
                                                                "example": 123
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "errors": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": []
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bot is not active for this currency or market not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Currency not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error during order generation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
