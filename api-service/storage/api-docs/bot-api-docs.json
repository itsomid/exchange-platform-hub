    "components": {
        "schemas": {
            "BotSetting": {
                "properties": {
                    "id": {
                        "description": "Setting ID",
                        "type": "integer",
                        "example": 1
                    },
                    "currency_id": {
                        "description": "Currency ID",
                        "type": "integer",
                        "example": 1
                    },
                    "currency_symbol": {
                        "description": "Currency symbol",
                        "type": "string",
                        "example": "BTC"
                    },
                    "is_active": {
                        "description": "Whether bot is active",
                        "type": "boolean",
                        "example": true
                    },
                    "price_interval_seconds": {
                        "description": "Price update interval in seconds",
                        "type": "integer",
                        "example": 60
                    },
                    "order_margin": {
                        "description": "Order margin percentage",
                        "type": "string",
                        "example": "0.5"
                    },
                    "buy_orders_count": {
                        "description": "Number of buy orders",
                        "type": "integer",
                        "example": 10
                    },
                    "sell_orders_count": {
                        "description": "Number of sell orders",
                        "type": "integer",
                        "example": 10
                    },
                    "created_at": {
                        "description": "Creation timestamp",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "Last update timestamp",
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "SuccessResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Operation completed successfully"
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "An error occurred"
                    }
                },
                "type": "object"
            },
            "UnauthorizedResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Unauthorized"
                    }
                },
                "type": "object"
            },
            "BulkOperationResult": {
                "properties": {
                    "currency_id": {
                        "description": "Currency ID",
                        "type": "integer",
                        "example": 1
                    },
                    "currency_name": {
                        "description": "Currency name",
                        "type": "string",
                        "example": "Bitcoin"
                    },
                    "status": {
                        "description": "Operation status",
                        "type": "string",
                        "example": "completed"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "description": "Enter JWT token in format: Bearer {token}",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
