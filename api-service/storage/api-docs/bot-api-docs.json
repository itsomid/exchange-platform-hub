{
    "openapi": "3.0.0",
    "info": {
        "title": "Bot API Documentation",
        "description": "API documentation for Bot services",
        "contact": {
            "email": "support@exchange.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/bot/v1",
            "description": "Bot API Server"
        }
    ],
    "paths": {
        "/token/generate": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Generate JWT token for bot authentication",
                "description": "Generate a JWT token with the provided payload for bot or accounting services",
                "operationId": "generateToken",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "secret_key",
                                    "payload"
                                ],
                                "properties": {
                                    "type": {
                                        "description": "Type of service requesting the token",
                                        "type": "string",
                                        "default": "bot",
                                        "enum": [
                                            "accounting",
                                            "bot"
                                        ]
                                    },
                                    "secret_key": {
                                        "description": "Secret key for authentication",
                                        "type": "string"
                                    },
                                    "payload": {
                                        "description": "Additional payload data for the token",
                                        "required": [
                                            "email"
                                        ],
                                        "properties": {
                                            "email": {
                                                "description": "Email address for the token",
                                                "type": "string",
                                                "format": "email"
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "description": "Generated JWT token",
                                            "type": "string"
                                        },
                                        "expires_at": {
                                            "description": "Token expiration date",
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "expiry_days": {
                                            "description": "Number of days until expiration",
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid secret key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid secret key"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Validation failed"
                                        },
                                        "errors": {
                                            "description": "Validation errors",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "An error occurred"
                                        },
                                        "error": {
                                            "description": "Error details",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/status/{currency_id}": {
            "get": {
                "tags": [
                    "Spot Bot Status"
                ],
                "summary": "Get bot status for specific currency",
                "description": "Retrieve the current status and settings of the spot bot for a specific currency",
                "operationId": "getBotStatus",
                "parameters": [
                    {
                        "name": "currency_id",
                        "in": "path",
                        "description": "Currency ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Bot status retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/BotSetting"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Currency or bot settings not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
