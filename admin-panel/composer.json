{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "enqueue/amqp-bunny": "^0.10.18",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.9.2",
        "jenssegers/agent": "^2.6",
        "kavenegar/laravel": "^1.3",
        "laravel/fortify": "^v1.24.4",
        "laravel/framework": "11.*",
        "laravel/pulse": "^1.1",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^v5.2.4",
        "laravel/tinker": "^v2.10.0",
        "maatwebsite/excel": "^3.1.55",
        "mews/captcha": "^3.3",
        "morilog/jalali": "3.*",
        "opcodesio/log-viewer": "^v3.11.2",
        "ratchet/pawl": "^0.4.1",
        "spatie/laravel-permission": "^6.10.1",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^v14.1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v3.14.6",
        "fakerphp/faker": "^v1.24.0",
        "laravel/pint": "^v1.18.1",
        "laravel/sail": "^v1.37.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.5.0",
        "phpunit/phpunit": "^11.4.3",
        "spatie/laravel-ignition": "^2.8.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/helper.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
