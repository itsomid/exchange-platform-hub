APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Bot Test Lab proxy → api-service
BOT_API_BASE_URL=http://api-service
# Must match BOT_INTERNAL_TEST_TOKEN in api_service.env
BOT_INTERNAL_TEST_TOKEN=
BOT_TEST_USER_ID=2

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
API_SYSTEM_DB_DATABASE=api_system
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#HD WALLET
HD_WALLET_BASE_URL=http://localhost:8888

# HD WALLET NEW (Node.js Service)
HD_WALLET_NEW_BASE_URL=http://localhost:3000
HD_WALLET_API_KEY=your-api-key-here
# Switch between 'old' and 'new' HD Wallet system
HD_WALLET_ACTIVE_SYSTEM=old

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=true

# Reverb internal app/server connection (used by Laravel backend to publish events)
# This can be an internal Docker hostname (for example: admin-reverb).
REVERB_APP_ID=669591
REVERB_APP_KEY=cdtebenizdu42kzefw6g
REVERB_APP_SECRET=bygrw0joxdifhlocmia8
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Public-facing Reverb connection (used by the BROWSER / Echo client)
# Must be reachable from user browsers. In production this is usually domain + 443 + https.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

# Build-time Vite fallback values for frontend websocket config.
# Runtime config injected by Blade is preferred; these are used when runtime values are absent.
VITE_REVERB_APP_KEY=cdtebenizdu42kzefw6g
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080

RABBITMQ_HOST=127.0.0.1
